# Slafurry Studios Website — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Values below are placeholders only; do not use in production.

# Provider pilihan (env, bukan edit kode): local | supabase
AUTH_PROVIDER=supabase
STORAGE_PROVIDER=supabase

# Kunci rahasia untuk sesi lokal (hanya wajib saat AUTH_PROVIDER=local).
# Buat dengan: openssl rand -base64 32
# JANGAN aktifkan di production / Vercel — localAuthProvider menolak start
# saat NODE_ENV=production atau VERCEL ter-set.
AUTH_LOCAL_SECRET=dev-local-secret-placeholder

# Supabase (newer key naming — see lib/supabase/*).
# Hanya wajib diisi saat AUTH_PROVIDER=supabase atau STORAGE_PROVIDER=supabase.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=pub-local-placeholder
SUPABASE_SECRET_KEY=secret-local-placeholder

# Prisma / database
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres"

# App URL (used for RSS + analytics absolute URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Contact email (Resend)
RESEND_API_KEY=re_local_placeholder
NEXT_PUBLIC_RESEND_API_KEY=re_local_placeholder
