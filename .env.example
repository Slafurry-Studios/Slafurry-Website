# Slafurry Studios Website — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Values below are placeholders only; do not use in production.

# Supabase (newer key naming — see lib/supabase/*)
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=pub-local-placeholder
SUPABASE_SECRET_KEY=secret-local-placeholder

# Prisma / database
DATABASE_URL="postgresql://postgres:password@localhost:54322/postgres"
DIRECT_URL="postgresql://postgres:password@localhost:54322/postgres"

# App URL (used for RSS + analytics absolute URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Contact email (Resend)
RESEND_API_KEY=re_local_placeholder
NEXT_PUBLIC_RESEND_API_KEY=re_local_placeholder
